@startuml
!include _style.iuml
title Діаграма активності: генерація вільних слотів (BE-03)
start
:Отримати master_id, service_id, дату;
:Завантажити тривалість послуги;
:Завантажити робочі інтервали майстра на дату;
:Завантажити активні записи на дату;
if (Дата в минулому?) then (так)
  :Повернути порожній список;
  stop
endif
repeat :Взяти наступний робочий інтервал;
  :t = початок інтервалу;
  while (t + тривалість <= кінець інтервалу?) is (так)
    if (t не в минулому і\nне перетинається з записами?) then (так)
      :Додати t до вільних слотів;
    endif
    :t = t + 15 хв;
  endwhile (ні)
repeat while (Є ще інтервали?) is (так) not (ні)
:Відсортувати й повернути слоти;
stop
@enduml
